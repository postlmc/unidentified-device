# llama.cpp server for private pre-processing (secret screening, summaries) on the RTX GPU.
#
# On demand, not at boot: there is no [Install] section, so it never starts itself and holds
# no VRAM while idle (Steam shares this GPU). Start it with `unid-llm-up`, stop it with
# `unid-llm-down`. Runs rootless as uid 1000, loopback only; reach it from the Mac through an SSH tunnel.
#
# SecurityLabelDisable is required: with SELinux enforcing, the container cannot open the CDI GPU
# device without it, and llama.cpp then falls back to CPU silently (verified in the 2026-11-25
# trial). `unid-llm-up` checks that the GPU is actually in use.
[Unit]
Description=llama.cpp server (GPU, loopback only)

[Container]
ContainerName=llama-server
# Pinned by digest (the tag moves daily); the digest wins over the tag. Not yet run on this host:
# the 2026-11-25 trial used an earlier server-cuda build. Bump deliberately, then rerun unid-llm-up.
Image=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:2855fd7d0f5781e289a8108c3abd0744d19621314641b97421c038be836ed373
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
PublishPort=127.0.0.1:8080:8080
Volume=/var/mnt/data/models:/models:ro
# 0.0.0.0 is inside the container's network namespace; the published port above is loopback only.
Exec=-m /models/Qwen2.5-14B-Instruct-Q4_K_M.gguf --host 0.0.0.0 --port 8080 -ngl 99 -c 16384 --parallel 1

[Service]
Restart=no
# First start pulls a 4.4 GB image.
TimeoutStartSec=900
