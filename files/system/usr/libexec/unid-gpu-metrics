#!/usr/bin/bash
# Write NVIDIA GPU metrics in Prometheus text format for node_exporter's textfile collector.
# Usage: unid-gpu-metrics [output-file]   (default /var/lib/node_exporter/textfile/unid_gpu.prom)
set -euo pipefail
out=${1:-/var/lib/node_exporter/textfile/unid_gpu.prom}
tmp=$(mktemp "$out.XXXXXX")
trap 'rm -f "$tmp"' EXIT

fields=utilization.gpu,utilization.memory,memory.used,memory.total,power.draw,temperature.gpu,clocks.sm,clocks.mem
line=$(nvidia-smi --query-gpu=$fields --format=csv,noheader,nounits | head -1)
IFS=',' read -r util mutil mused mtotal power temp smclk memclk <<<"$line"

emit() { # name help type value [multiplier]
    local v=${4// /}
    [[ $v =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0   # skip "[N/A]" and empty
    printf '# HELP %s %s\n# TYPE %s %s\n%s %s\n' "$1" "$2" "$1" "$3" "$1" "$(awk -v v="$v" -v m="${5:-1}" 'BEGIN{printf "%.12g", v*m}')"
}
{
    emit unid_gpu_utilization_percent "GPU core utilization" gauge "$util"
    emit unid_gpu_memory_controller_utilization_percent "GPU memory controller utilization" gauge "$mutil"
    emit unid_gpu_memory_used_bytes "GPU memory in use" gauge "$mused" 1048576
    emit unid_gpu_memory_total_bytes "GPU memory total" gauge "$mtotal" 1048576
    emit unid_gpu_power_watts "GPU power draw" gauge "$power"
    emit unid_gpu_temperature_celsius "GPU temperature" gauge "$temp"
    emit unid_gpu_sm_clock_mhz "GPU SM clock" gauge "$smclk"
    emit unid_gpu_memory_clock_mhz "GPU memory clock" gauge "$memclk"
    apps=$(nvidia-smi --query-compute-apps=used_memory --format=csv,noheader,nounits | awk 'NF{n++; s+=$1} END{printf "%d %d", n, s}')
    emit unid_gpu_compute_processes "Processes with a compute context on the GPU" gauge "${apps% *}"
    emit unid_gpu_compute_memory_used_bytes "GPU memory used by compute processes" gauge "${apps#* }" 1048576
} >"$tmp"
chmod 644 "$tmp"
mv "$tmp" "$out"
trap - EXIT
